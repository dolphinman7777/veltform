# Cloudflare otherwise makes browsers re-check every file on every visit.

# Next.js puts a content hash in these filenames, so they can be kept indefinitely.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# These keep their names when replaced, so browsers re-check after a week and refresh quietly.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
